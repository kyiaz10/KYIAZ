<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ежедневник · Трекер задач</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          paper: '#F5F3EE',
          ink: '#232722',
          muted: '#767C73',
          card: '#FFFFFF',
          sage: '#54695D',
          sagelight: '#E7EDE6',
          amber: '#B8763E',
          amberlight: '#F5E7D6',
          line: '#E4E1D8'
        },
        fontFamily: {
          display: ['Fraunces', 'serif'],
          sans: ['Inter', 'sans-serif']
        }
      }
    }
  }
</script>
<style>
  body { font-family: 'Inter', sans-serif; }
  .font-display { font-family: 'Fraunces', serif; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-10px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes slideOut {
    from { opacity: 1; transform: translateX(0); max-height: 100px; margin-bottom: 0.5rem; }
    to { opacity: 0; transform: translateX(12px); max-height: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
  }
  .task-enter { animation: slideIn 0.28s ease-out; }
  .task-leave { animation: slideOut 0.28s ease-in forwards; overflow: hidden; }

  .checkbox-ring {
    transition: all 0.2s ease;
  }
  .checkbox-ring:hover {
    transform: scale(1.08);
  }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-thumb { background: #D8D4C8; border-radius: 999px; }

  input:focus-visible, button:focus-visible {
    outline: 2px solid #54695D;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .task-enter, .task-leave { animation: none !important; }
  }
</style>
</head>
<body class="bg-paper text-ink min-h-screen antialiased">

  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 sm:py-14">

    <!-- Header -->
    <header class="mb-8 sm:mb-10">
      <p class="text-xs tracking-[0.2em] uppercase text-muted font-medium mb-2" id="today-date">Загрузка даты…</p>
      <div class="flex items-end justify-between gap-4 flex-wrap">
        <h1 class="font-display text-4xl sm:text-5xl text-ink">Мои задачи</h1>
        <div class="flex gap-3 text-sm">
          <div class="flex flex-col items-center bg-card rounded-xl px-4 py-2 shadow-sm border border-line min-w-[68px]">
            <span id="open-count" class="font-display text-xl text-sage leading-none">0</span>
            <span class="text-[11px] text-muted mt-1 uppercase tracking-wide">в работе</span>
          </div>
          <div class="flex flex-col items-center bg-card rounded-xl px-4 py-2 shadow-sm border border-line min-w-[68px]">
            <span id="done-count" class="font-display text-xl text-amber leading-none">0</span>
            <span class="text-[11px] text-muted mt-1 uppercase tracking-wide">готово</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Add form -->
    <form id="add-form" class="mb-8 sm:mb-10">
      <div class="bg-card rounded-2xl shadow-sm border border-line p-2 flex items-center gap-2 focus-within:border-sage/50 transition-colors">
        <input
          id="task-input"
          type="text"
          placeholder="Что нужно сделать?"
          autocomplete="off"
          maxlength="200"
          class="flex-1 bg-transparent px-3 py-2.5 text-[15px] placeholder:text-muted/70 focus:outline-none"
        >
        <button
          type="submit"
          class="shrink-0 bg-sage hover:bg-sage/90 active:scale-95 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-all duration-150 shadow-sm"
        >
          Добавить
        </button>
      </div>
    </form>

    <!-- Active tasks -->
    <section class="mb-10">
      <h2 class="font-display text-lg text-ink/80 mb-3">В работе</h2>
      <div id="active-list" class="flex flex-col gap-2"></div>
      <p id="active-empty" class="hidden text-sm text-muted italic py-6 text-center bg-card/50 rounded-2xl border border-dashed border-line">
        Пока пусто. Добавьте первую задачу выше.
      </p>
    </section>

    <!-- Completed tasks -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-display text-lg text-ink/80">Выполнено</h2>
        <button
          id="clear-done"
          class="text-xs text-muted hover:text-amber transition-colors font-medium tracking-wide uppercase disabled:opacity-0"
        >
          Очистить всё
        </button>
      </div>
      <div id="done-list" class="flex flex-col gap-2"></div>
      <p id="done-empty" class="hidden text-sm text-muted italic py-6 text-center bg-card/50 rounded-2xl border border-dashed border-line">
        Выполненные задачи появятся здесь.
      </p>
    </section>

    <footer class="mt-14 text-center text-xs text-muted/70">
      Данные хранятся локально в этом браузере
    </footer>

  </div>

<script>
(function () {
  const STORAGE_KEY = 'todoTracker.tasks.v1';

  const activeList = document.getElementById('active-list');
  const doneList = document.getElementById('done-list');
  const activeEmpty = document.getElementById('active-empty');
  const doneEmpty = document.getElementById('done-empty');
  const openCountEl = document.getElementById('open-count');
  const doneCountEl = document.getElementById('done-count');
  const form = document.getElementById('add-form');
  const input = document.getElementById('task-input');
  const clearDoneBtn = document.getElementById('clear-done');
  const dateEl = document.getElementById('today-date');

  /** @type {{id: string, text: string, done: boolean, createdAt: number}[]} */
  let tasks = [];

  function loadTasks() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      tasks = raw ? JSON.parse(raw) : [];
      if (!Array.isArray(tasks)) tasks = [];
    } catch (e) {
      console.error('Не удалось прочитать данные из LocalStorage:', e);
      tasks = [];
    }
  }

  function saveTasks() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));
    } catch (e) {
      console.error('Не удалось сохранить данные в LocalStorage:', e);
    }
  }

  function uid() {
    return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
  }

  function setDate() {
    const now = new Date();
    const formatted = now.toLocaleDateString('ru-RU', { weekday: 'long', day: 'numeric', month: 'long' });
    dateEl.textContent = formatted.charAt(0).toUpperCase() + formatted.slice(1);
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function createActiveTaskEl(task) {
    const el = document.createElement('div');
    el.className = 'task-enter bg-card rounded-2xl shadow-sm border border-line px-4 py-3 flex items-center gap-3 group';
    el.dataset.id = task.id;
    el.innerHTML = `
      <button class="checkbox-ring shrink-0 w-6 h-6 rounded-full border-2 border-sage/40 hover:border-sage flex items-center justify-center" data-action="complete" aria-label="Отметить выполненным"></button>
      <span class="flex-1 text-[15px] text-ink break-words">${escapeHtml(task.text)}</span>
      <button class="shrink-0 text-xs font-medium text-muted opacity-0 group-hover:opacity-100 hover:text-amber transition-all px-2 py-1" data-action="delete" aria-label="Удалить задачу">
        Удалить
      </button>
    `;
    return el;
  }

  function createDoneTaskEl(task) {
    const el = document.createElement('div');
    el.className = 'task-enter bg-card/60 rounded-2xl border border-line px-4 py-3 flex items-center gap-3';
    el.dataset.id = task.id;
    el.innerHTML = `
      <span class="shrink-0 w-6 h-6 rounded-full bg-amber flex items-center justify-center text-white text-xs">✓</span>
      <span class="flex-1 text-[15px] text-muted line-through break-words">${escapeHtml(task.text)}</span>
      <button class="shrink-0 text-xs font-medium text-muted hover:text-red-500 transition-colors px-2 py-1" data-action="delete" aria-label="Удалить задачу">
        Удалить
      </button>
    `;
    return el;
  }

  function render() {
    const active = tasks.filter(t => !t.done);
    const done = tasks.filter(t => t.done);

    activeList.innerHTML = '';
    active.forEach(t => activeList.appendChild(createActiveTaskEl(t)));
    activeEmpty.classList.toggle('hidden', active.length > 0);

    doneList.innerHTML = '';
    done.forEach(t => doneList.appendChild(createDoneTaskEl(t)));
    doneEmpty.classList.toggle('hidden', done.length > 0);

    openCountEl.textContent = active.length;
    doneCountEl.textContent = done.length;
    clearDoneBtn.disabled = done.length === 0;
  }

  function addTask(text) {
    const trimmed = text.trim();
    if (!trimmed) return;
    tasks.unshift({ id: uid(), text: trimmed, done: false, createdAt: Date.now() });
    saveTasks();
    render();
  }

  function removeTaskWithAnimation(taskEl, onDone) {
    taskEl.classList.remove('task-enter');
    taskEl.classList.add('task-leave');
    taskEl.addEventListener('animationend', onDone, { once: true });
  }

  function completeTask(id) {
    const taskEl = activeList.querySelector(`[data-id="${id}"]`);
    if (!taskEl) return;
    removeTaskWithAnimation(taskEl, () => {
      const task = tasks.find(t => t.id === id);
      if (task) task.done = true;
      saveTasks();
      render();
    });
  }

  function deleteTask(id) {
    const container = document.querySelector(`[data-id="${id}"]`);
    if (!container) return;
    removeTaskWithAnimation(container, () => {
      tasks = tasks.filter(t => t.id !== id);
      saveTasks();
      render();
    });
  }

  function clearCompleted() {
    const doneEls = doneList.querySelectorAll('[data-id]');
    if (doneEls.length === 0) return;
    let remaining = doneEls.length;
    doneEls.forEach(el => {
      removeTaskWithAnimation(el, () => {
        remaining -= 1;
        if (remaining === 0) {
          tasks = tasks.filter(t => !t.done);
          saveTasks();
          render();
        }
      });
    });
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    addTask(input.value);
    input.value = '';
    input.focus();
  });

  activeList.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    const id = btn.closest('[data-id]').dataset.id;
    if (btn.dataset.action === 'complete') completeTask(id);
    if (btn.dataset.action === 'delete') deleteTask(id);
  });

  doneList.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    const id = btn.closest('[data-id]').dataset.id;
    if (btn.dataset.action === 'delete') deleteTask(id);
  });

  clearDoneBtn.addEventListener('click', clearCompleted);

  setDate();
  loadTasks();
  render();
})();
</script>
</body>
</html>
